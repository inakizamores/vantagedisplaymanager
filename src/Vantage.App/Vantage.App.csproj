<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Vantage</AssemblyName>
    <RootNamespace>Vantage.App</RootNamespace>
    <!-- Shown as the file description in Explorer, Task Manager and the SmartScreen prompt,
         which would otherwise fall back to the bare assembly name. -->
    <AssemblyTitle>Vantage Display Manager</AssemblyTitle>
    <ApplicationIcon>Assets\vantage.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Our own entry point instead of the one WPF generates, so a shortcut launch can hand
         its request to the running instance before a single WPF type is touched. Building the
         WPF Application costs ~1 s; the handover itself costs single-digit milliseconds. -->
    <StartupObject>Vantage.App.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compiling App.xaml as a Page rather than the ApplicationDefinition keeps its generated
         InitializeComponent but drops the generated Main that would clash with Program. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vantage.Core\Vantage.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\vantage.ico" />
  </ItemGroup>
</Project>
