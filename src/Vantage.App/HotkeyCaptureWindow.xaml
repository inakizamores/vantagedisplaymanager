<Window
    x:Class="Vantage.App.HotkeyCaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Set hotkey"
    Width="400"
    SizeToContent="Height"
    ResizeMode="NoResize"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">
    <StackPanel Margin="24,16,24,20">
        <ui:TextBlock FontTypography="Subtitle" x:Name="TitleText" Text="Set hotkey" Margin="0,0,0,4" />
        <TextBlock
            Text="Press the key combination to assign (must include Ctrl, Alt, Shift or Win)."
            TextWrapping="Wrap"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Margin="0,0,0,16" />

        <Border
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="16,14">
            <TextBlock
                x:Name="GestureText"
                Text="Waiting for keys…"
                FontSize="16"
                FontWeight="SemiBold"
                HorizontalAlignment="Center" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="Remove hotkey" Click="OnClear" x:Name="ClearButton" />
            <ui:Button Margin="8,0,0,0" Content="Cancel" IsCancel="True" Click="OnCancel" />
            <ui:Button
                x:Name="SaveButton"
                Margin="8,0,0,0"
                Appearance="Primary"
                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                Content="Save"
                IsEnabled="False"
                Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
