<Window
    x:Class="Vantage.App.ShortcutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Preset shortcut"
    Width="520"
    SizeToContent="Height"
    ResizeMode="NoResize"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">
    <StackPanel Margin="24,16,24,20">
        <ui:TextBlock FontTypography="Subtitle" Text="Preset shortcut" Margin="0,0,0,4" />
        <TextBlock
            Text="Launch this preset straight from the Start menu — type its name, press Enter, displays switch. No window opens."
            TextWrapping="Wrap"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Margin="0,0,0,16" />

        <!-- Live preview of the tile the user is about to create. -->
        <Border
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12"
            Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Image
                    x:Name="IconPreview"
                    Width="48"
                    Height="48"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock x:Name="PreviewName" FontTypography="BodyStrong" Text="Preset" />
                    <TextBlock
                        x:Name="PreviewTarget"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis"
                        MaxWidth="380"
                        HorizontalAlignment="Left"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ui:TextBlock FontTypography="BodyStrong" Text="Name" Margin="0,0,0,6" />
        <ui:TextBox
            x:Name="NameBox"
            PlaceholderText="Shortcut name…"
            TextChanged="OnNameChanged"
            Margin="0,0,0,16" />

        <ui:TextBlock FontTypography="BodyStrong" Text="Put it in" Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="StartMenuCheck" Content="Start menu" IsChecked="True" />
            <CheckBox x:Name="DesktopCheck" Content="Desktop" Margin="24,0,0,0" />
        </StackPanel>
        <CheckBox
            x:Name="GroupCheck"
            Content="Group presets under a 'Vantage Presets' folder"
            Margin="0,4,0,0" />
        <TextBlock
            Text="Off by default: grouped presets sit inside a heading you have to expand in All apps, instead of listing directly alongside your other apps."
            FontSize="12"
            TextWrapping="Wrap"
            Margin="26,2,0,16"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

        <ui:TextBlock FontTypography="BodyStrong" Text="Icon" Margin="0,0,0,6" />
        <RadioButton
            x:Name="LayoutIconChoice"
            GroupName="Icon"
            Content="Monitor layout"
            IsChecked="True"
            Checked="OnIconChoiceChanged"
            Margin="0,0,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <RadioButton
                x:Name="CustomIconChoice"
                Grid.Column="0"
                GroupName="Icon"
                Content="Custom image or program"
                VerticalAlignment="Center"
                Checked="OnIconChoiceChanged" />
            <ui:Button
                Grid.Column="1"
                Appearance="Secondary"
                Icon="{ui:SymbolIcon FolderOpen24}"
                Content="Browse…"
                Click="OnBrowse" />
        </Grid>
        <TextBlock
            x:Name="CustomIconText"
            FontSize="12"
            Margin="26,4,0,0"
            TextTrimming="CharacterEllipsis"
            Visibility="Collapsed"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

        <TextBlock
            x:Name="ErrorText"
            Foreground="#E81123"
            TextWrapping="Wrap"
            Visibility="Collapsed"
            Margin="0,12,0,0" />

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button
                x:Name="RemoveButton"
                Grid.Column="0"
                Appearance="Secondary"
                Icon="{ui:SymbolIcon Delete24}"
                Content="Remove"
                Visibility="Collapsed"
                Click="OnRemove" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Content="Cancel" IsCancel="True" Click="OnCancel" />
                <ui:Button
                    x:Name="CreateButton"
                    Margin="8,0,0,0"
                    Appearance="Primary"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                    Icon="{ui:SymbolIcon Checkmark24}"
                    Content="Create shortcut"
                    Click="OnCreate" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
