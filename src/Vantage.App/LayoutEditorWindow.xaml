<Window
    x:Class="Vantage.App.LayoutEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Arrange displays"
    Width="760"
    Height="520"
    ResizeMode="NoResize"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">
    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <ui:TextBlock FontTypography="Subtitle" Text="Arrange displays" />
            <TextBlock
                Text="Drag displays to rearrange them — they snap to each other's edges. Changes are verified when you apply, and revert automatically if anything goes wrong."
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Canvas x:Name="EditorCanvas" ClipToBounds="True" />
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" IsCancel="True" Click="OnCancel" />
                <ui:Button
                    x:Name="ApplyButton"
                    Margin="8,0,0,0"
                    Appearance="Primary"
                    Foreground="White"
                    Icon="{ui:SymbolIcon Checkmark24}"
                    Content="Apply arrangement"
                    Click="OnApply" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
