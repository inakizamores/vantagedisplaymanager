<Window
    x:Class="Vantage.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Vantage.App"
    xmlns:vm="clr-namespace:Vantage.App.ViewModels"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Title="Vantage Display Manager"
    Icon="pack://application:,,,/Assets/vantage.ico"
    Width="880"
    Height="760"
    MinWidth="560"
    MinHeight="480"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanConverter x:Key="InverseBool" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:StringToSymbolConverter x:Key="StringToSymbol" />
        <system:Boolean x:Key="False">False</system:Boolean>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,24">
            <StackPanel MaxWidth="820" Margin="24,8,24,0">

                <ui:InfoBar
                    Title="{Binding StatusTitle}"
                    Message="{Binding StatusMessage}"
                    Severity="{Binding StatusSeverity}"
                    IsOpen="{Binding StatusOpen, Mode=TwoWay}"
                    Margin="0,0,0,12" />

                <!-- Displays -->
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" FontTypography="Subtitle" Text="Displays" />
                    <ui:ProgressRing
                        Grid.Column="1"
                        Width="20" Height="20"
                        Margin="0,0,12,0"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <ui:Button
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Icon="{ui:SymbolIcon Grid24}"
                        Content="Arrange"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Command="{Binding OpenLayoutEditorCommand}" />
                    <ui:Button
                        Grid.Column="3"
                        Appearance="Secondary"
                        Icon="{ui:SymbolIcon ArrowClockwise24}"
                        Content="Refresh"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Command="{Binding RefreshCommand}" />
                </Grid>

                <TextBlock
                    Text="{Binding BusyText}"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,8" />

                <ItemsControl ItemsSource="{Binding Displays}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DisplayItemViewModel}">
                            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Desktop24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                            <TextBlock
                                                Text="{Binding BadgeText}"
                                                Margin="8,1,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{Binding ModeText}"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Text="{Binding DetailText}"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch
                                    Content="HDR"
                                    IsChecked="{Binding HdrOn, Mode=TwoWay}"
                                    Visibility="{Binding HdrSupported, Converter={StaticResource BoolToVis}}" />
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Profiles -->
                <ui:TextBlock FontTypography="Subtitle" Text="Profiles" Margin="0,20,0,8" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- All three stretch to the row height so the box and the buttons line up
                         top and bottom; left to themselves the buttons sit shorter than the box. -->
                    <ui:TextBox
                        Grid.Column="0"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        PlaceholderText="Name this setup (e.g. Desk, TV, Racing)…"
                        Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                        Icon="{ui:SymbolIcon Save24}"
                        Content="Save current setup"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Command="{Binding SaveProfileCommand}" />
                    <ui:Button
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Appearance="Secondary"
                        Icon="{ui:SymbolIcon Add24}"
                        Content="New preset…"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Command="{Binding NewPresetCommand}" />
                </Grid>

                <!-- First-run empty state: the tray menu and CLI both explain themselves when
                     there are no profiles; the main window shouldn't be the one that doesn't. -->
                <Border
                    Visibility="{Binding HasProfiles, Converter={StaticResource InverseBoolToVis}}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16"
                    Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Board24" FontSize="20" Margin="0,0,10,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="No profiles yet" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Arrange your displays the way you like — here with Arrange, or in Windows Settings — then name the setup above and press Save current setup. Each saved profile switches everything back in one click, one hotkey, or one Start menu shortcut." />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfileItemViewModel}">
                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Source="{Binding LayoutImage}"
                                            Width="88"
                                            Height="40"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center"
                                            RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                                <TextBlock
                                                    Text="{Binding StatusText}"
                                                    Margin="8,1,0,0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock
                                                Text="{Binding SummaryText}"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <!-- Stretch every button to the row height. Left alone, the ones
                                     carrying text size 2px taller than the icon-only ones, so the
                                     row of actions reads as ragged. -->
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button
                                        VerticalAlignment="Stretch"
                                        Appearance="Secondary"
                                        Icon="{ui:SymbolIcon Keyboard24}"
                                        Content="{Binding HotkeyText}"
                                        ToolTip="Set a global hotkey for this profile"
                                        Command="{Binding DataContext.SetHotkeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                    <!-- Labelled once a shortcut exists, the same way the hotkey
                                         button labels itself with the gesture. -->
                                    <ui:Button
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Stretch"
                                        Appearance="Secondary"
                                        Icon="{ui:SymbolIcon Pin24}"
                                        Content="{Binding ShortcutText}"
                                        ToolTip="{Binding ShortcutTooltip}"
                                        Command="{Binding DataContext.CreateShortcutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                    <ui:Button
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Stretch"
                                        Appearance="Secondary"
                                        Icon="{ui:SymbolIcon Save24}"
                                        ToolTip="Overwrite this profile with the current setup"
                                        Command="{Binding DataContext.OverwriteProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                    <ui:Button
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Stretch"
                                        Appearance="Secondary"
                                        Content="Apply"
                                        IsEnabled="{Binding IsPossible}"
                                        Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                    <ui:Button
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Stretch"
                                        Appearance="Secondary"
                                        Icon="{ui:SymbolIcon Delete24}"
                                        ToolTip="Delete profile"
                                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                </StackPanel>
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Settings -->
                <ui:TextBlock FontTypography="Subtitle" Text="Settings" Margin="0,20,0,8" />

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Power24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Start with Windows" />
                            <TextBlock
                                Text="Opens quietly in the system tray when you sign in — no window, instant profiles"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Dismiss24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Keep running in the tray when closed" />
                            <TextBlock
                                Text="Closing the window keeps profiles, hotkeys and shortcuts one right-click away. Off means the close button exits Vantage entirely"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Folder24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Your data" />
                            <TextBlock
                                Text="Profiles, settings, shortcut icons and the diagnostic log live in Documents\Vantage Display Manager — they survive updates and reinstalls"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button
                        VerticalAlignment="Stretch"
                        Appearance="Secondary"
                        Icon="{ui:SymbolIcon FolderOpen24}"
                        Content="Open folder"
                        Command="{Binding OpenDataFolderCommand}" />
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Wrench24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Repair preset shortcuts" />
                            <TextBlock
                                Text="Puts back any Start menu or desktop shortcut an update or reinstall broke — Start pins return to their spots"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button
                        VerticalAlignment="Stretch"
                        Appearance="Secondary"
                        Icon="{ui:SymbolIcon Wrench24}"
                        Content="Repair now"
                        Command="{Binding RepairShortcutsCommand}" />
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowSync24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Check for updates at startup" />
                            <TextBlock
                                Text="A quiet look at GitHub when Vantage starts — nothing downloads or installs without you choosing it"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding CheckUpdatesAtStartup, Mode=TwoWay}" />
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowSync24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding VersionText}" />
                            <TextBlock
                                Text="{Binding UpdateStatus}"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing
                            Width="20" Height="20"
                            Margin="0,0,12,0"
                            IsIndeterminate="True"
                            Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BoolToVis}}" />
                        <!-- One button, two jobs: check while up to date, install once there's
                             something to install. Portable copies get a link instead. -->
                        <ui:Button
                            VerticalAlignment="Stretch"
                            Appearance="Secondary"
                            Icon="{ui:SymbolIcon Open24}"
                            Content="Releases page"
                            Visibility="{Binding CanSelfUpdate, Converter={StaticResource InverseBoolToVis}}"
                            Command="{Binding OpenReleasesPageCommand}" />
                        <ui:Button
                            VerticalAlignment="Stretch"
                            Appearance="Secondary"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            Content="Check for updates"
                            IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBool}}"
                            Visibility="{Binding ShowCheckButton, Converter={StaticResource BoolToVis}}"
                            Command="{Binding CheckForUpdatesCommand}"
                            CommandParameter="{StaticResource False}" />
                        <ui:Button
                            VerticalAlignment="Stretch"
                            Appearance="Primary"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            Icon="{ui:SymbolIcon ArrowDownload24}"
                            Content="Update"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                            Command="{Binding InstallUpdateCommand}" />
                    </StackPanel>
                </ui:CardControl>

                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    Text="Every profile switch is verified — if a change doesn't take effect correctly, your previous setup is restored automatically." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
