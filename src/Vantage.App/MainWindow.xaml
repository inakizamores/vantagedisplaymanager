<Window
    x:Class="Vantage.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Vantage.App"
    xmlns:vm="clr-namespace:Vantage.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Title="Vantage"
    Icon="pack://application:,,,/Assets/vantage.ico"
    Width="880"
    Height="760"
    MinWidth="560"
    MinHeight="480"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanConverter x:Key="InverseBool" />
        <local:StringToSymbolConverter x:Key="StringToSymbol" />
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,24">
            <StackPanel MaxWidth="820" Margin="24,8,24,0">

                <ui:InfoBar
                    Title="{Binding StatusTitle}"
                    Message="{Binding StatusMessage}"
                    Severity="{Binding StatusSeverity}"
                    IsOpen="{Binding StatusOpen, Mode=TwoWay}"
                    Margin="0,0,0,12" />

                <!-- Displays -->
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" FontTypography="Subtitle" Text="Displays" />
                    <ui:ProgressRing
                        Grid.Column="1"
                        Width="20" Height="20"
                        Margin="0,0,12,0"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <ui:Button
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Icon="{ui:SymbolIcon Grid24}"
                        Content="Arrange"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Command="{Binding OpenLayoutEditorCommand}" />
                    <ui:Button
                        Grid.Column="3"
                        Appearance="Secondary"
                        Icon="{ui:SymbolIcon ArrowClockwise24}"
                        Content="Refresh"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Command="{Binding RefreshCommand}" />
                </Grid>

                <TextBlock
                    Text="{Binding BusyText}"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,8" />

                <ItemsControl ItemsSource="{Binding Displays}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DisplayItemViewModel}">
                            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Desktop24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                            <TextBlock
                                                Text="{Binding BadgeText}"
                                                Margin="8,1,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{Binding ModeText}"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Text="{Binding DetailText}"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch
                                    Content="HDR"
                                    IsChecked="{Binding HdrOn, Mode=TwoWay}"
                                    Visibility="{Binding HdrSupported, Converter={StaticResource BoolToVis}}" />
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Profiles -->
                <ui:TextBlock FontTypography="Subtitle" Text="Profiles" Margin="0,20,0,8" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        Grid.Column="0"
                        PlaceholderText="Name this setup (e.g. Desk, TV, Racing)…"
                        Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Appearance="Primary"
                        Foreground="White"
                        Icon="{ui:SymbolIcon Save24}"
                        Content="Save current setup"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Command="{Binding SaveProfileCommand}" />
                    <ui:Button
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Appearance="Secondary"
                        Icon="{ui:SymbolIcon Add24}"
                        Content="New preset…"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Command="{Binding NewPresetCommand}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfileItemViewModel}">
                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Source="{Binding LayoutImage}"
                                            Width="88"
                                            Height="40"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center"
                                            RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                                <TextBlock
                                                    Text="{Binding StatusText}"
                                                    Margin="8,1,0,0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock
                                                Text="{Binding SummaryText}"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button
                                        Appearance="Secondary"
                                        Icon="{ui:SymbolIcon Keyboard24}"
                                        Content="{Binding HotkeyText}"
                                        ToolTip="Set a global hotkey for this profile"
                                        Command="{Binding DataContext.SetHotkeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                    <ui:Button
                                        Margin="8,0,0,0"
                                        Appearance="Secondary"
                                        Content="Apply"
                                        IsEnabled="{Binding IsPossible}"
                                        Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                    <ui:Button
                                        Margin="8,0,0,0"
                                        Appearance="Secondary"
                                        Icon="{ui:SymbolIcon Delete24}"
                                        ToolTip="Delete profile"
                                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                </StackPanel>
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Settings -->
                <ui:TextBlock FontTypography="Subtitle" Text="Settings" Margin="0,20,0,8" />

                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Power24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Start with Windows" />
                            <TextBlock
                                Text="Opens quietly in the system tray when you sign in — no window, instant profiles"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                </ui:CardControl>

                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    Text="Vantage keeps running in the system tray when you close this window. Every profile switch is verified — if a change doesn't take effect correctly, your previous setup is restored automatically." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
