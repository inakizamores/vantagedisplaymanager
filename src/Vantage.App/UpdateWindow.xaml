<Window
    x:Class="Vantage.App.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Update Vantage"
    Width="560"
    Height="600"
    MinWidth="460"
    MinHeight="420"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">
    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <ui:TextBlock x:Name="HeadlineText" FontTypography="Subtitle" Text="Update available" Margin="0,0,0,4" />
            <TextBlock
                x:Name="SubtitleText"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Margin="0,0,0,16" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="NotesPanel" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <ProgressBar
                x:Name="DownloadProgress"
                Height="4"
                Margin="0,0,0,12"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="StatusText"
                TextWrapping="Wrap"
                Margin="0,0,0,12"
                Visibility="Collapsed"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="LaterButton" Content="Later" IsCancel="True" Click="OnLater" />
                <ui:Button
                    x:Name="UpdateButton"
                    Margin="8,0,0,0"
                    Appearance="Primary"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                    Icon="{ui:SymbolIcon ArrowDownload24}"
                    Content="Update and restart"
                    Click="OnUpdate" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
