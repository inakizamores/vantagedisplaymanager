<Window
    x:Class="Vantage.App.PresetEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="New preset"
    Width="560"
    SizeToContent="Height"
    MaxHeight="720"
    ResizeMode="NoResize"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">
    <StackPanel Margin="24,16,24,20">
        <ui:TextBlock FontTypography="Subtitle" Text="New preset" Margin="0,0,0,4" />
        <TextBlock
            Text="Pick the mode each display should use. The preset is created from your current arrangement — nothing changes until you apply it."
            TextWrapping="Wrap"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Margin="0,0,0,16" />

        <ui:TextBox
            x:Name="NameBox"
            PlaceholderText="Preset name (e.g. Racing, Cinema, Desk)…"
            Margin="0,0,0,16" />

        <ItemsControl x:Name="Rows">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,0,0,8">
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Grid.Column="0"
                                    ItemsSource="{Binding Resolutions}"
                                    SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    MinWidth="110"
                                    ItemsSource="{Binding RefreshRates}"
                                    SelectedItem="{Binding SelectedRefreshRate, Mode=TwoWay}" />
                                <ui:ToggleSwitch
                                    Grid.Column="2"
                                    Margin="16,0,0,0"
                                    Content="HDR"
                                    IsChecked="{Binding HdrOn, Mode=TwoWay}"
                                    Visibility="{Binding HdrVisibility}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
            x:Name="ErrorText"
            Foreground="#E81123"
            TextWrapping="Wrap"
            Visibility="Collapsed"
            Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="Cancel" IsCancel="True" Click="OnCancel" />
            <ui:Button
                Margin="8,0,0,0"
                Appearance="Primary"
                Foreground="White"
                Icon="{ui:SymbolIcon Checkmark24}"
                Content="Create preset"
                Click="OnCreate" />
        </StackPanel>
    </StackPanel>
</Window>
